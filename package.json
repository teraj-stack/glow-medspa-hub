{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run validate:brand && npm run validate:content && npm run validate:nap && npm run validate:geo && npm run validate:twitter-card && vite build && npm run brand:validate-or-fix:dist && npm run validate:nap:dist && npm run report:content",
    "build:dev": "npm run validate:brand && npm run validate:content && npm run validate:nap && npm run validate:geo && npm run validate:twitter-card && vite build --mode development && npm run brand:validate-or-fix:dist && npm run validate:nap:dist && npm run report:content",
    "report:content": "node scripts/content-quality-report.mjs",
    "validate:brand": "node scripts/validate-brand.mjs",
    "validate:brand:dist": "node scripts/validate-brand-dist.mjs",
    "brand:fix:dist": "node scripts/fix-brand-dist.mjs",
    "brand:fix:dist:apply": "node scripts/fix-brand-dist.mjs --apply",
    "brand:validate-or-fix:dist": "node scripts/brand-validate-or-fix.mjs",
    "brand:validate-or-fix:dist:strict": "node scripts/brand-validate-or-fix.mjs --strict",
    "brand:report:sarif": "node scripts/brand-report-sarif.mjs",
    "validate:content": "node scripts/validate-content.mjs --section=all",
    "validate:technologie": "node scripts/validate-content.mjs --section=technologie",
    "validate:blog": "node scripts/validate-content.mjs --section=blog",
    "validate:nap": "node scripts/validate-nap.mjs --scope=src",
    "validate:nap:dist": "node scripts/validate-nap.mjs --scope=dist --json=reports/nap-dist.json",
    "validate:geo": "node scripts/validate-geo-jsonld.mjs --json=reports/geo-jsonld.json",
    "validate:twitter-card": "node scripts/validate-twitter-card.mjs --json=reports/twitter-card.json",
    "audit:rls": "node scripts/audit-rls.mjs",
    "validate:content:report": "node scripts/validate-content.mjs --section=all --json=reports/content-quality.json --html=reports/content-quality.html",
    "test:e2e:technologie": "python3 tests/e2e/technologie_content_quality.py",
    "test:e2e:content": "python3 tests/e2e/content_quality.py",
    "test:e2e:tile02-visual": "python3 tests/e2e/tile_02_visual_regression.py",
    "test:e2e:tile-przywrocenie-konturow-visual": "python3 tests/e2e/tile_przywrocenie_konturow_visual_regression.py",
    "test:e2e:tile-przywrocenie-konturow-a11y": "python3 -u tests/e2e/tile_przywrocenie_konturow_a11y.py",
    "test:e2e:header-visual": "python3 tests/e2e/header_visual_regression.py",
    "test:e2e:mapowanie-starzenia-visual": "python3 tests/e2e/mapowanie_procesu_starzenia_visual_regression.py",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepare": "git config core.hooksPath .githooks || true"
  },
